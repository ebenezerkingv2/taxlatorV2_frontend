{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],

		"module": "ESNext",
		"moduleResolution": "Bundler",

		"jsx": "react-jsx",

		"strict": true,
		"skipLibCheck": true,

		"types": ["node"],

		"baseUrl": ".",

		"paths": {
			"@api/*": ["src/api/*"],
			"@hooks/*": ["src/components/dashboard/dashHooks/*"],
			"@components/*": ["src/components/*"],
			"@context/*": ["src/context/*"],
			"@utils/*": ["src/utils/*"]
		},

		"ignoreDeprecations": "6.0"
	},

	"include": ["src"]
}
